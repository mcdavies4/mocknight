# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC...           # from @BotFather
TELEGRAM_BOT_USERNAME=MockNightBot          # without the @
TELEGRAM_WEBHOOK_SECRET=change-me-long-random-string

# --- App ---
APP_URL=https://mocknight.vercel.app        # public https URL, no trailing slash
CRON_SECRET=change-me-another-random-string
DASHBOARD_SIGNING_SECRET=change-me-third-random-string

# --- Supabase ---
SUPABASE_URL=https://xxxx.supabase.co
